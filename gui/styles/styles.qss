QMainWindow {
    background-color: #1e1e1e;
}

QLabel {
    color: #cccccc;
    font-size: 11px;
    font-weight: normal;
    padding: 2px;
}

QLabel#progressLabel {
    color: #aaaaaa;
    font-size: 9px;
    padding: 1px;
}

QListWidget {
    background-color: #262626;
    color: #cccccc;
    border: none;
    font-size: 11px;
    padding: 6px;
}

QListWidget::item {
    padding: 3px;
}

QListWidget::item:selected {
    background-color: #3949ab;
    color: #ffffff;
}

QPushButton {
    background-color: #3949ab;
    color: #ffffff;
    border: none;
    padding: 5px 10px;
    font-size: 11px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #2e3b8e;
}

QPushButton:disabled {
    background-color: #3a3a3a;
    color: #666666;
}

QPushButton:pressed {
    background-color: #1c2526;
}

QLineEdit {
    background-color: #262626;
    color: #cccccc;
    border: none;
    border-radius: 3px;
    padding: 5px;
    font-size: 11px;
}

QLineEdit:focus {
    background-color: #2e2e2e;
}

QTextEdit {
    background-color: #262626;
    color: #cccccc;
    border: none;
    border-radius: 3px;
    font-size: 11px;
    padding: 6px;
}

QScrollArea {
    background-color: #262626;
    border: none;
    border-radius: 3px;
}

QProgressBar {
    background-color: #262626;
    color: #cccccc;
    border: none;
    border-radius: 3px;
    text-align: center;
    font-size: 9px;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #3949ab;
    border-radius: 3px;
}

QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
}